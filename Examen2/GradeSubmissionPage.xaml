<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.GradeSubmissionPage"
             Title="Calificar Tarea"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *">
                <Button Text="←" FontSize="20" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="Transparent" Clicked="OnSaveGradeClicked" VerticalOptions="Center" Padding="0" WidthRequest="40" HeightRequest="40" IsVisible="false" />
                <Label Grid.Column="1" Text="Calificar Entrega de Alumno" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" HorizontalOptions="Start" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Center">
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="LblStudentName" FontSize="20" FontAttributes="Bold" TextColor="#61E5CE" />
                        <Label x:Name="LblTaskTitle" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Label x:Name="LblSubmittedAt" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Archivo entregado" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#181D23}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenFileClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="📄" FontSize="16" VerticalOptions="Center" />
                                <Label x:Name="LblFileName" Text="archivo_adjunto.pdf" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#334155, Dark=#61E5CE}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Calificación (0 - 100)" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtGrade" Placeholder="Ej. 95" Keyboard="Numeric" MaxLength="3" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Comentarios privados / Retroalimentación" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Editor x:Name="TxtFeedback" Placeholder="Escribe tus observaciones..." HeightRequest="100" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>

                        <Button x:Name="BtnSaveGrade" Text="Guardar Calificación" Clicked="OnSaveGradeClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>