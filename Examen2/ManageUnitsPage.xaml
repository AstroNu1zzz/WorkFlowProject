<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.ManageUnitsPage"
             Title="Gestionar Unidades"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *">
                <Button Text="←" FontSize="20" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="Transparent" Clicked="OnAddUnitClicked" VerticalOptions="Center" Padding="0" WidthRequest="40" HeightRequest="40" IsVisible="false" />
                <Label Grid.Column="1" Text="Gestión de Unidades y Criterios" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" HorizontalOptions="Start" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="700" HorizontalOptions="Center">
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Crear Nueva Unidad o Parcial" FontSize="16" FontAttributes="Bold" TextColor="#61E5CE" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre de la unidad" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtUnitTitle" Placeholder="Ej. Parcial 1" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Fecha de inicio" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <DatePicker x:Name="DpStart" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Fecha de fin" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <DatePicker x:Name="DpEnd" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="Añadir Unidad" Clicked="OnAddUnitClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="45" CornerRadius="10" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Unidades Registradas (Toca una para ver criterios)" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <CollectionView x:Name="CvUnits" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUnitSelectedTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            <Label Text="{Binding ., StringFormat='Del {0:dd/MM/yyyy} al {1:dd/MM/yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="Configurar →" FontSize="13" FontAttributes="Bold" TextColor="#5EEAD4" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Border x:Name="BorderCriteriaPanel" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#181D23}" IsVisible="false">
                    <VerticalStackLayout Spacing="16">
                        <Label x:Name="LblSelectedUnitTitle" FontSize="16" FontAttributes="Bold" TextColor="#5EEAD4" />
                        <Label x:Name="LblTotalPercentage" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Grid ColumnDefinitions="*, 100, Auto" ColumnSpacing="10">
                            <Entry x:Name="TxtCriterionName" Grid.Column="0" Placeholder="Nombre (ej. Examen)" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                            <Entry x:Name="TxtCriterionPercentage" Grid.Column="1" Placeholder="%" Keyboard="Numeric" MaxLength="3" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                            <Button Grid.Column="2" Text="+" Clicked="OnAddCriterionClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" WidthRequest="45" HeightRequest="45" CornerRadius="10" />
                        </Grid>
                        <CollectionView x:Name="CvCriteria" SelectionMode="None" HeightRequest="150">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 10" Padding="12,8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Name}" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Percentage, StringFormat='{0}%'}" FontSize="14" FontAttributes="Bold" TextColor="#5EEAD4" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="✕" FontSize="12" TextColor="#EF4444" BackgroundColor="Transparent" CommandParameter="{Binding .}" Clicked="OnDeleteCriterionClicked" WidthRequest="35" HeightRequest="35" Padding="0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>