<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             Title="Mis Clases"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.08" Offset="0,2" Radius="6" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*, Auto, Auto">
                <Label Text="WorkFlow - Clases" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="⚙️" FontSize="16" BackgroundColor="Transparent" Clicked="OnSettingsClicked" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" />
                <Button Grid.Column="2" Text="＋" FontSize="20" FontAttributes="Bold" TextColor="#61E5CE" BackgroundColor="Transparent" Clicked="OnAddCourseClicked" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" />
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL (Vinculado al ViewModel) -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="14" MaximumWidthRequest="700" HorizontalOptions="Center">
                <CollectionView x:Name="CvCourses" ItemsSource="{Binding Courses}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="14" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCourseTapped" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="110, Auto">
                                    <Image Source="{Binding BannerImagePath}" Grid.Row="0" Aspect="AspectFill" />
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="4">
                                        <Label Text="{Binding CourseName}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                        <Label Text="{Binding DisplayTeacherName, StringFormat='Prof. {0}'}" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA INFERIOR -->
        <Border Grid.Row="2" StrokeThickness="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="*, *" HorizontalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" WidthRequest="120">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabClassesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📚" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Clases" FontSize="11" FontAttributes="Bold" TextColor="#5EEAD4" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" WidthRequest="120">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabSettingsTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⚙️" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Ajustes" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>