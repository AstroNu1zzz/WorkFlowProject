<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.RegisterPage"
             Title="Crear Cuenta"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView>
        <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
            <Border WidthRequest="380"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                    StrokeShape="RoundRectangle 20"
                    Padding="30"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.15" Offset="0,8" Radius="16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Crear Cuenta" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               TextColor="#61E5CE" 
                               HorizontalOptions="Center" />
                        <Label Text="Únete a WorkFlow hoy" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Nombre de usuario" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtUsername" Placeholder="Ej. alan_carrillo" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtEmail" Placeholder="ejemplo@correo.com" Keyboard="Email" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtPassword" Placeholder="Crea una contraseña segura" IsPassword="True" TextChanged="OnPasswordTextChanged" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Margin="0,2,0,2">
                            <Label x:Name="LblReqLength" Text="• Mínimo 8 caracteres" FontSize="11" TextColor="#EF4444" />
                            <Label x:Name="LblReqUpper" Text="• Al menos una letra mayúscula" FontSize="11" TextColor="#EF4444" />
                            <Label x:Name="LblReqNumber" Text="• Al menos un número" FontSize="11" TextColor="#EF4444" />
                            <Label x:Name="LblReqSpecial" Text="• Al menos un carácter especial" FontSize="11" TextColor="#EF4444" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Confirmar contraseña" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Entry x:Name="TxtConfirmPassword" Placeholder="Repite tu contraseña" IsPassword="True" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Button Text="Registrarse"
                            Clicked="OnRegisterClicked"
                            BackgroundColor="#61E5CE"
                            TextColor="#0F172A"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="48"
                            CornerRadius="12"
                            Margin="0,4,0,0" />

                    <Button Text="← Volver a Iniciar Sesión"
                            Clicked="OnBackToLoginClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#5C93F9, Dark=#5EEAD4}"
                            FontSize="13"
                            Padding="0"
                            HeightRequest="30"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>