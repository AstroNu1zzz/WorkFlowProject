<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.UnitGradesPage"
             Title="Calificaciones por Unidad"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Label Text="Calificaciones y Promedios" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" />
        </Border>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="700" HorizontalOptions="Center">
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Selecciona una unidad o parcial" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Picker x:Name="PickerUnits" Title="Elige la unidad" SelectedIndexChanged="OnUnitPickerChanged" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="BorderStudentSummary" StrokeThickness="1" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#181D23}" IsVisible="false">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Tu Calificación Final en esta Unidad" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                        <Label x:Name="LblStudentFinalGrade" Text="0 / 100" FontSize="28" FontAttributes="Bold" TextColor="#5EEAD4" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Detalle de Calificaciones" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <CollectionView x:Name="CvGradesSummary" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding StudentName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            <Label Text="{Binding StatusText}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding FinalGradeText}" FontSize="15" FontAttributes="Bold" TextColor="#5EEAD4" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>