<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.EditProfilePage"
             Title="Editar Perfil"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *">

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0"
                Padding="16,12"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                <ImageButton Grid.Column="0"
                             Source="icon_arrow_back.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="OnBackButtonClicked" />

                <Label Grid.Column="1"
                       Text="Editar Perfil"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
            </Grid>
        </Border>

        <!-- CONTENIDO DE EDICIÓN -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="22" MaximumWidthRequest="500" HorizontalOptions="Center">

                <!-- FOTO DE PERFIL Y CAMBIO -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,10,0,10">
                    <Border WidthRequest="90"
                            HeightRequest="90"
                            StrokeShape="RoundRectangle 45"
                            StrokeThickness="2"
                            Stroke="#5EEAD4"
                            BackgroundColor="#1E2B3C"
                            HorizontalOptions="Center">
                        <Grid>
                            <Label x:Name="LblEditInitial"
                                   Text="U"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image x:Name="ImgEditAvatar"
                                   Aspect="AspectFill"
                                   IsVisible="False" />
                        </Grid>
                    </Border>

                    <Button Text="📷 Cambiar foto de perfil"
                            Clicked="OnChangePhotoClicked"
                            BackgroundColor="Transparent"
                            TextColor="#5EEAD4"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="0" />
                </VerticalStackLayout>

                <!-- CAMPOS DE DATOS -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre de usuario" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Entry x:Name="TxtEditUsername"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Entry x:Name="TxtEditEmail"
                               Keyboard="Email"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- BOTÓN GUARDAR CAMBIOS -->
                <Button Text="Guardar Cambios"
                        Clicked="OnSaveProfileClicked"
                        BackgroundColor="#5EEAD4"
                        TextColor="#0F172A"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>