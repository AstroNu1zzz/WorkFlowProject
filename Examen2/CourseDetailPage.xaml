<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseDetailPage"
             Title="Detalle del Curso"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Text="←" FontSize="20" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" VerticalOptions="Center" Padding="0" WidthRequest="40" HeightRequest="40" />
                <Label Grid.Column="1" Text="{Binding Course.CourseName}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Button x:Name="BtnManageUnits" Grid.Column="2" Text="⚙️ Unidades" FontSize="13" TextColor="#61E5CE" BackgroundColor="Transparent" Clicked="OnManageUnitsClicked" VerticalOptions="Center" />
                <Button x:Name="BtnAddTeacher" Grid.Column="3" Text="＋ Prof" FontSize="13" TextColor="#5C93F9" BackgroundColor="Transparent" Clicked="OnAddTeacherClicked" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollView x:Name="ViewNovedades" IsVisible="True">
                <VerticalStackLayout Spacing="16" Padding="16">
                    <Border HeightRequest="130" StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#181D23}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCourseInfoClicked" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="{Binding Course.BannerImagePath}" Aspect="AspectFill" />
                            <BoxView Color="#60000000" />
                            <VerticalStackLayout VerticalOptions="End" Padding="18" Spacing="4">
                                <Label Text="{Binding Course.CourseName}" FontSize="20" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Course.DisplayTeacherName, StringFormat='Prof. {0}'}" FontSize="13" TextColor="#CBD5E1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="BorderCreatePost" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 14" Padding="14,12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreatePostTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17" StrokeThickness="0" BackgroundColor="#61E5CE">
                                <Label Text="📢" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Anunciar algo a tu clase..." FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="add_icon.png" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" Clicked="OnCreatePostOptionsClicked" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FeedPosts}" Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeedPostTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="{Binding IconBgColor}">
                                                <Label Text="{Binding IconSymbol}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Label Text="{Binding DateFormatted}" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>
                                            <ImageButton Grid.Column="2" Clicked="OnPostOptionsClicked" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" />
                                        </Grid>
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" IsVisible="{Binding HasDescription}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView x:Name="ViewTrabajos" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="14">
                    <CollectionView x:Name="CvAssignmentsGrouped" SelectionMode="None" />
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView x:Name="ViewPersonas" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="20">
                    <CollectionView x:Name="CvTeachers" SelectionMode="None" />
                    <CollectionView x:Name="CvStudents" SelectionMode="None" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Border Grid.Row="2" StrokeThickness="0" Padding="10,8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Grid ColumnDefinitions="*, *, *" HorizontalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" WidthRequest="90">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabNovedadesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📢" FontSize="18" HorizontalOptions="Center" />
                    <Label x:Name="TabNovedadesLabel" Text="Novedades" FontSize="11" FontAttributes="Bold" TextColor="#5EEAD4" HorizontalOptions="Center" />
                    <BoxView x:Name="TabNovedadesIndicator" HeightRequest="2" Color="#5EEAD4" WidthRequest="30" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" WidthRequest="90">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📋" FontSize="18" HorizontalOptions="Center" />
                    <Label x:Name="TabTrabajosLabel" Text="Trabajos" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                    <BoxView x:Name="TabTrabajosIndicator" HeightRequest="2" Color="Transparent" WidthRequest="30" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" WidthRequest="90">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabPersonasTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👥" FontSize="18" HorizontalOptions="Center" />
                    <Label x:Name="TabPersonasLabel" Text="Personas" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                    <BoxView x:Name="TabPersonasIndicator" HeightRequest="2" Color="Transparent" WidthRequest="30" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border x:Name="FabAdd" Grid.Row="1" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28" StrokeThickness="0" BackgroundColor="#61E5CE" IsVisible="false">
            <Grid>
                <Label Text="+" FontSize="28" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button BackgroundColor="Transparent" Clicked="OnCreatePostOptionsClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>