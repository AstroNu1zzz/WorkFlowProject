<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.DayTasksPage"
             Title="Entregas del Día"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16" MaximumWidthRequest="750" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="LblSelectedDate"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                <Label Text="Tareas programadas para entrega en esta fecha"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <CollectionView x:Name="CvDayTasks" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 14"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaskItemTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="6, *" ColumnSpacing="12">
                                <BoxView Grid.Column="0"
                                         BackgroundColor="{Binding GradientStartColor}"
                                         VerticalOptions="Fill" />

                                <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="12,16,16,16" VerticalOptions="Center">
                                    <Border Grid.Column="0"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding GradientStartColor}">
                                        <Label Text="📋"
                                               FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayTitle}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#382020}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding DueDateString}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#F87171" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>