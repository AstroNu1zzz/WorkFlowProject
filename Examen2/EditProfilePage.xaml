<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.EditProfilePage"
             Title="Editar Perfil"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Center">
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Información Personal" FontSize="16" FontAttributes="Bold" TextColor="#61E5CE" />
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre de usuario" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Entry x:Name="TxtUsername" Placeholder="Tu nombre de usuario" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                    </VerticalStackLayout>

                    <Button Text="Actualizar Nombre de Usuario" Clicked="OnUpdateUsernameClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="42" CornerRadius="10" />

                    <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                        <Label Text="Correo electrónico" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label x:Name="LblCurrentEmail" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Label x:Name="LblEmailVerifiedStatus" Text="Sin verificar" FontSize="12" FontAttributes="Bold" TextColor="#F87171" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Verificar Correo" Clicked="OnVerifyEmailClicked" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#374151}" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="12" HeightRequest="38" CornerRadius="8" />
                            <Button Grid.Column="1" Text="Cambiar Correo" Clicked="OnChangeEmailClicked" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#374151}" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="12" HeightRequest="38" CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Seguridad y Contraseña" FontSize="16" FontAttributes="Bold" TextColor="#61E5CE" />
                    <Label Text="Cambia tu contraseña de forma segura mediante un código de verificación enviado a tu correo." FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <Button Text="Cambiar Contraseña (2FA)" Clicked="OnChangePassword2FAClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="45" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>