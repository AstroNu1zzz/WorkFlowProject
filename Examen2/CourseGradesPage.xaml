<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseGradesPage"
             Title="Calificaciones por Unidad"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16" MaximumWidthRequest="750" HorizontalOptions="Center">
            <Label Text="Resumen de Calificaciones"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

            <CollectionView x:Name="CvUnitGrades" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding UnitTitle}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                        <Label Text="{Binding StatusText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{Binding StatusColor}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            Padding="12,6"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#132A2B"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding FinalGradeText}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#5EEAD4" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" />

                                <Label Text="{Binding CriteriaBreakdown}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>