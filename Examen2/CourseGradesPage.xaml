<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseGradesPage"
             Title="Calificaciones por Unidad"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="18" MaximumWidthRequest="800" HorizontalOptions="Center">
            <Label Text="Resumen de Calificaciones"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

            <CollectionView x:Name="CvUnitGrades" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="18" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="12">

                                <!-- CABECERA DE LA UNIDAD -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding UnitTitle}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                        <Label Text="{Binding StatusText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{Binding StatusColor}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            Padding="12,6"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#132A2B"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding HeaderBadgeText}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#5EEAD4" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" />

                                <!-- LISTA DE ALUMNOS EN LA UNIDAD -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Students}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#161B22}">
                                                <VerticalStackLayout Spacing="10">

                                                    <!-- FILA PRINCIPAL DEL ALUMNO + BOTÓN VER MÁS -->
                                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                            <Label Text="👤" FontSize="15" VerticalOptions="Center" />
                                                            <Label Text="{Binding StudentName}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>

                                                        <Label Grid.Column="1"
                                                               Text="{Binding FinalScoreText}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#5EEAD4"
                                                               VerticalOptions="Center" />

                                                        <Button Grid.Column="2"
                                                                Text="{Binding ToggleButtonText}"
                                                                FontSize="12"
                                                                FontAttributes="Bold"
                                                                TextColor="#5C93F9"
                                                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                                                                CornerRadius="8"
                                                                HeightRequest="32"
                                                                Padding="12,0"
                                                                Clicked="OnToggleStudentDetailsClicked" />
                                                    </Grid>

                                                    <!-- PANEL DESPLEGABLE CON DESGLOSE DE CRITERIOS Y TAREAS -->
                                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="12" Padding="0,6,0,0">
                                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" />

                                                        <!-- 1. CÁLCULO POR CRITERIO -->
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="📐 Desglose por Criterios de Evaluación"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#5EEAD4" />

                                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CriteriaBreakdown}" Spacing="4">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnDefinitions="*, Auto">
                                                                            <Label Grid.Column="0"
                                                                                   Text="{Binding CriterionSummary}"
                                                                                   FontSize="12"
                                                                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                                                            <Label Grid.Column="1"
                                                                                   Text="{Binding EarnedPointsText}"
                                                                                   FontSize="12"
                                                                                   FontAttributes="Bold"
                                                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>

                                                        <!-- 2. LISTA DETALLADA DE TAREAS DE LA UNIDAD -->
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="📋 Tareas de la Unidad"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#5C93F9" />

                                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tasks}" Spacing="6">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="10,8"
                                                                                StrokeThickness="1"
                                                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                                                                StrokeShape="RoundRectangle 8"
                                                                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                                                    <Label Text="{Binding TaskTitle}"
                                                                                           FontSize="13"
                                                                                           FontAttributes="Bold"
                                                                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                                                    <Label Text="{Binding CriterionTag}"
                                                                                           FontSize="11"
                                                                                           TextColor="#64748B" />
                                                                                </VerticalStackLayout>

                                                                                <Border Grid.Column="1"
                                                                                        Padding="8,4"
                                                                                        StrokeThickness="0"
                                                                                        StrokeShape="RoundRectangle 6"
                                                                                        BackgroundColor="{Binding StatusBadgeBg}"
                                                                                        VerticalOptions="Center">
                                                                                    <Label Text="{Binding StatusText}"
                                                                                           FontSize="11"
                                                                                           FontAttributes="Bold"
                                                                                           TextColor="{Binding StatusTextColor}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>

                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>