<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.StudentAcademicPage"
             Title="Historial y Calificaciones"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <Grid RowDefinitions="Auto, *">

        <!-- ENCABEZADO: PROMEDIO GENERAL + 2 PESTAÑAS -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="16,14,16,0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.08" Offset="0,3" Radius="8" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Promedio General"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label x:Name="LblGeneralAverage"
                               Text="0.00"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#5EEAD4" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Padding="10,6"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#12161A}"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView x:Name="DotAcademicTrafficLight"
                                     WidthRequest="10"
                                     HeightRequest="10"
                                     CornerRadius="5"
                                     Color="#86EFAC"
                                     VerticalOptions="Center" />
                            <Label x:Name="LblAcademicTrafficLight"
                                   Text="Estado: Regular"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- BARRA DE 2 PESTAÑAS -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button x:Name="BtnTabPerformance"
                            Grid.Column="0"
                            Text="Rendimiento"
                            Clicked="OnTabPerformanceClicked"
                            BackgroundColor="Transparent"
                            TextColor="#5EEAD4"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="38"
                            Padding="0" />

                    <Button x:Name="BtnTabGrades"
                            Grid.Column="1"
                            Text="Calificaciones"
                            Clicked="OnTabGradesClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="38"
                            Padding="0" />
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <BoxView x:Name="IndicatorPerformance" Grid.Column="0" HeightRequest="3" CornerRadius="1.5" Color="#5EEAD4" />
                    <BoxView x:Name="IndicatorGrades" Grid.Column="1" HeightRequest="3" CornerRadius="1.5" Color="Transparent" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO DE PESTAÑAS -->
        <Grid Grid.Row="1">

            <!-- PESTAÑA 1: RENDIMIENTO -->
            <ScrollView x:Name="ScrollPerformance" IsVisible="True" Padding="16">
                <VerticalStackLayout Spacing="16" MaximumWidthRequest="700" HorizontalOptions="Fill">

                    <!-- SEMÁFORO ACADÉMICO -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                            <Border x:Name="BorderTrafficBadge"
                                    Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="0"
                                    BackgroundColor="#86EFAC">
                                <Label x:Name="LblTrafficIcon"
                                       Text="●"
                                       FontSize="20"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblTrafficTitle"
                                       Text="Semáforo Académico: Verde"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <Label x:Name="LblTrafficDescription"
                                       Text="Situación académica favorable según promedio, entregas y asistencia."
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- DESGLOSE DESPLEGABLE DEL PERIODO ACTUAL (DEBAJO DEL SEMÁFORO) -->
                    <VerticalStackLayout x:Name="ContainerSemesters" Spacing="12" />

                    <!-- PROMEDIO GENERAL Y PERIODO EN CURSO -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Promedio General" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblPerfGeneralAvg" Text="0.00" FontSize="22" FontAttributes="Bold" TextColor="#5EEAD4" />
                                <Label x:Name="LblPerfVsPrevious" Text="vs. anterior: --" FontSize="11" TextColor="#5C93F9" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Periodo en Curso" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblPerfCurrentTermAvg" Text="0.00" FontSize="22" FontAttributes="Bold" TextColor="#86EFAC" />
                                <Label x:Name="LblPerfTermName" Text="Periodo actual" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- TAREAS ENTREGADAS Y ASISTENCIA -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Tareas Entregadas" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblTasksRatio" Text="0 / 0" FontSize="22" FontAttributes="Bold" TextColor="#5C93F9" />
                                <Label x:Name="LblTasksCompliance" Text="0% cumplimiento" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Asistencia" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblAttendancePercent" Text="0%" FontSize="22" FontAttributes="Bold" TextColor="#5EEAD4" />
                                <Label x:Name="LblAttendanceDetail" Text="Registro del periodo" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- GRÁFICA DE TENDENCIA A LO LARGO DEL TIEMPO -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Tendencia de Promedio por Semestre"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                            <GraphicsView x:Name="TrendChartView"
                                          HeightRequest="170" />

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" />

                            <VerticalStackLayout x:Name="ContainerSemesterComparison" Spacing="8" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- PESTAÑA 2: CALIFICACIONES -->
            <ScrollView x:Name="ScrollGrades" IsVisible="False" Padding="16">
                <VerticalStackLayout Spacing="14" MaximumWidthRequest="700" HorizontalOptions="Fill">

                    <!-- FILTRO AMPLIO POR PERIODO / SEMESTRE -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Periodo:"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#5EEAD4"
                                   VerticalOptions="Center" />

                            <Picker Grid.Column="1"
                                    x:Name="PickerGradePeriod"
                                    SelectedIndexChanged="OnGradePeriodChanged"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                    FontSize="14"
                                    HorizontalOptions="Fill" />
                        </Grid>
                    </Border>

                    <!-- RESUMEN RÁPIDO DE ASIGNATURAS EN EL PERIODO -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Asignaturas" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblGradesSubjectCount" Text="0" FontSize="18" FontAttributes="Bold" TextColor="#5C93F9" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Promedio del Periodo" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                <Label x:Name="LblGradesPeriodAvg" Text="0.00" FontSize="18" FontAttributes="Bold" TextColor="#86EFAC" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="Desglose por Asignatura"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <CollectionView x:Name="CvSubjectGrades" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="16"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding SubjectName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    Padding="10,4"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#12161A}">
                                                <Label Text="{Binding FinalGradeText}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#5EEAD4" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1"
                                                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" />

                                        <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="6">
                                            <Border Grid.Column="0" Padding="4,8" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                                    <Label Text="1ro" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                    <Label Text="{Binding Eval1}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border Grid.Column="1" Padding="4,8" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                                    <Label Text="2do" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                    <Label Text="{Binding Eval2}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border Grid.Column="2" Padding="4,8" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                                    <Label Text="3ro" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                    <Label Text="{Binding Eval3}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border Grid.Column="3" Padding="4,8" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                                    <Label Text="Extra" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                    <Label Text="{Binding Extra}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border Grid.Column="4" Padding="4,8" StrokeThickness="1" Stroke="#5EEAD4" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                                    <Label Text="Final" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#5EEAD4" />
                                                    <Label Text="{Binding Final}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#5EEAD4" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>
</ContentPage>