<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CreateContentPage"
             Title="Crear Contenido"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="650" HorizontalOptions="Center">
            <Label x:Name="LblHeaderTitle" Text="Crear Contenido" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" Margin="4,0" />

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Título / Asunto" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Entry x:Name="TxtTitle" Placeholder="Escribe el título..." TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Instrucciones o contenido" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Editor x:Name="TxtDescription" Placeholder="Describe los detalles..." HeightRequest="120" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LayoutCriterionPicker" Spacing="6">
                        <Label x:Name="LblActiveUnitName" Text="Unidad Activa" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label x:Name="LblCriterionWarning" Text="Aviso de criterio" FontSize="11" TextColor="#EF4444" IsVisible="false" />
                        <Picker x:Name="PickerCriteria" Title="Seleccionar criterio" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LayoutDueDate" Spacing="6">
                        <Label Text="Fecha y hora de entrega" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <DatePicker x:Name="DpDueDate" Grid.Column="0" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <TimePicker x:Name="TpDueTime" Grid.Column="1" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Archivo adjunto (Opcional)" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#181D23}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickFileClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="📎" FontSize="16" VerticalOptions="Center" />
                                <Label x:Name="LblAttachedFileName" Text="Adjuntar Imagen o PDF" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#334155, Dark=#61E5CE}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HeightRequest="45" />
                        <Button x:Name="BtnPublish" Grid.Column="1" Text="Publicar" Clicked="OnPublishClicked" BackgroundColor="#61E5CE" TextColor="#0F172A" FontAttributes="Bold" HeightRequest="45" CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>