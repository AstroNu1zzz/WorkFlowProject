<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             x:Name="mainPage"
             Title="Página Principal"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="CardShadow" Brush="#000000" Opacity="0.12" Offset="0,4" Radius="10" />
            <Shadow x:Key="FabShadow" Brush="#5EEAD4" Opacity="0.4" Offset="0,6" Radius="14" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- BARRA SUPERIOR PERSONALIZADA -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.06" Offset="0,2" Radius="6" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="14" VerticalOptions="Center">
                <Image Grid.Column="0"
                       Source="app_logo.jpg"
                       WidthRequest="30"
                       HeightRequest="30"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="Work" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Label Text="Flow" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#5EEAD4" />
                </HorizontalStackLayout>

                <Button Grid.Column="2"
                        Text="＋"
                        FontSize="20"
                        TextColor="#5EEAD4"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"
                        Command="{Binding AddCourseCommand}" />

                <Border Grid.Column="3"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeShape="RoundRectangle 19"
                        StrokeThickness="1.5"
                        Stroke="#86EFAC">
                    <Grid>
                        <Button Text="{Binding UserInitial}"
                                Command="{Binding ToggleProfileMenuCommand}"
                                BackgroundColor="#1E2B3C"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="0" />

                        <Image Source="{Binding ProfileImageSource}"
                               IsVisible="{Binding HasProfilePicture}"
                               Aspect="AspectFill">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENEDOR CENTRAL DE VISTAS -->
        <Grid Grid.Row="1">

            <!-- VISTA 1: CLASES Y NOVEDADES -->
            <ScrollView x:Name="ViewClases" IsVisible="True">
                <VerticalStackLayout Spacing="24" Padding="0,16,0,100">

                    <!-- MIS CLASES INSCRITAS -->
                    <VerticalStackLayout Spacing="12">
                        <Grid Padding="20,0" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Mis Clases Inscritas"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                            <Label Grid.Column="1"
                                   Text="Ver todas"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#5C93F9"
                                   VerticalOptions="Center" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding EnrolledCourses}"
                                        SelectionMode="None"
                                        HeightRequest="150"
                                        HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.Header>
                                <BoxView WidthRequest="14" Color="Transparent" />
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <BoxView WidthRequest="14" Color="Transparent" />
                            </CollectionView.Footer>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="240"
                                            HeightRequest="140"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                            StrokeShape="RoundRectangle 18"
                                            Shadow="{StaticResource CardShadow}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid>
                                            <Image Source="{Binding BannerImagePath}"
                                                   Aspect="AspectFill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />

                                            <Border StrokeThickness="0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#30000000" Offset="0.0" />
                                                        <GradientStop Color="#850F172A" Offset="0.5" />
                                                        <GradientStop Color="#F00F172A" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>

                                                <Grid Padding="16" RowDefinitions="*, Auto">
                                                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                                                        <Label Text="{Binding CourseName}" 
                                                               FontSize="16" 
                                                               FontAttributes="Bold" 
                                                               TextColor="White"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>

                                                    <Label Grid.Row="1"
                                                           Text="{Binding DisplayTeacherName, StringFormat='Prof. {0}'}"
                                                           FontSize="11"
                                                           TextColor="#E2E8F0"
                                                           LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- TABLÓN DE NOVEDADES GLOBAL -->
                    <VerticalStackLayout Spacing="12" Padding="20,0">
                        <Label Text="Tablón de Novedades"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding GlobalRecentActivities}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="16"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                                            Shadow="{StaticResource CardShadow}">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={x:Reference mainPage}, Path=BindingContext.OpenActivityCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" RowDefinitions="Auto, Auto">
                                            <Border Grid.Row="0" Grid.Column="0"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeShape="RoundRectangle 20"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{Binding GradientStartColor}">
                                                <Label Text="{Binding IconString}" 
                                                       FontSize="18" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding DisplayTitle}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" 
                                                                    Margin="0,8,0,0" 
                                                                    IsVisible="{Binding HasDueDate}">
                                                <Border Padding="8,3"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#382020}">
                                                    <Label Text="{Binding DueDateString}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#F87171" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 2: TAREAS PENDIENTES -->
            <ScrollView x:Name="ViewTareas" IsVisible="False">
                <VerticalStackLayout Spacing="16" Padding="20,16,20,100">
                    <Label Text="Tareas Pendientes"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Label Text="Aquí puedes visualizar tus actividades y entregas pendientes de todas tus clases."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GlobalRecentActivities}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference mainPage}, Path=BindingContext.OpenActivityCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                        <Label Text="{Binding IconString}" FontSize="22" VerticalOptions="Center"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding DisplayTitle}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B"/>
                                            <Label Text="{Binding DueDateString}" FontSize="11" TextColor="#EF4444" IsVisible="{Binding HasDueDate}" Margin="0,2,0,0"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 3: CALENDARIO DE ENTREGAS -->
            <ScrollView x:Name="ViewCalendario" IsVisible="False">
                <VerticalStackLayout Spacing="16" Padding="16,16,16,100">

                    <Label Text="Agenda de Entregas"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <!-- ENCABEZADO Y MES -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" Text="◀" BackgroundColor="Transparent" TextColor="#5EEAD4" FontSize="16" />
                        <Label Grid.Column="1" Text="Noviembre de 2026" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Button Grid.Column="2" Text="▶" BackgroundColor="Transparent" TextColor="#5EEAD4" FontSize="16" />
                    </Grid>

                    <!-- CABECERA DÍAS SEMANA -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4">
                        <Label Grid.Column="0" Text="D" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="1" Text="L" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="2" Text="M" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="3" Text="M" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="4" Text="J" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="5" Text="V" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label Grid.Column="6" Text="S" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#64748B"/>
                    </Grid>

                    <!-- MATRIZ DE DÍAS -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                        <!-- Fila 1 -->
                        <Border Grid.Row="0" Grid.Column="0" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="1" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="2" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="3" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="4" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="5" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="6" Margin="6" FontSize="12"/>
                        </Border>

                        <!-- Día 7 con Barrita de Tarea -->
                        <Border Grid.Row="0" Grid.Column="6" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1.5" Stroke="#5EEAD4" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Grid RowDefinitions="*, Auto">
                                <Label Text="7" Margin="6" FontSize="12" FontAttributes="Bold"/>
                                <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#5EEAD4" Margin="4,0,4,4"/>
                            </Grid>
                        </Border>

                        <!-- Fila 2 (Día 8 y 10 con barrita) -->
                        <Border Grid.Row="1" Grid.Column="0" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1.5" Stroke="#5EEAD4" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Grid RowDefinitions="*, Auto">
                                <Label Text="8" Margin="6" FontSize="12" FontAttributes="Bold"/>
                                <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#5EEAD4" Margin="4,0,4,4"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="9" Margin="6" FontSize="12"/>
                        </Border>

                        <!-- Día 10 (Seleccionado / Hoy) -->
                        <Border Grid.Row="1" Grid.Column="2" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="#5C93F9" BackgroundColor="#1E2B3C">
                            <Grid RowDefinitions="*, Auto">
                                <Label Text="10" Margin="6" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                <BoxView Grid.Row="1" HeightRequest="4" CornerRadius="2" Color="#5EEAD4" Margin="4,0,4,4"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="11" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="12" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="13" Margin="6" FontSize="12"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="6" HeightRequest="60" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Label Text="14" Margin="6" FontSize="12"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- MENÚ DESPLEGABLE FLOTANTE DE PERFIL -->
            <Border HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,10,20,0"
                    WidthRequest="240"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsProfileMenuVisible}"
                    ZIndex="100">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Padding="14" Spacing="6">
                    <Label Text="{Binding CurrentUser.Username}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Label Text="{Binding CurrentUser.Email}" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" Margin="0,4" />

                    <Button Text="📷  Cambiar foto"
                            Command="{Binding ChangeProfilePictureCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                            HorizontalOptions="Start" />

                    <Button Text="⚙️  Configuración"
                            Command="{Binding NavigateSettingsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                            HorizontalOptions="Start" />

                    <Button Text="🚪  Cerrar sesión"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#EF4444"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- BOTÓN FLOTANTE (FAB) -->
            <Border HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,22,24"
                    WidthRequest="60"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="0"
                    Background="{StaticResource WorkflowBrandBrush}"
                    Shadow="{StaticResource FabShadow}">
                <Grid>
                    <Label Text="+"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,-2,0,0" />
                    <Button BackgroundColor="Transparent"
                            Command="{Binding AddCourseCommand}" />
                </Grid>
            </Border>

        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR -->
        <Border Grid.Row="2"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#272E38}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                Padding="0,6,0,10">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Pestaña 1: Clases -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📚" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabClasesLabel"
                           Text="Clases" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           TextColor="#5EEAD4" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabClasesIndicator"
                             HeightRequest="3" 
                             WidthRequest="24" 
                             Color="#5EEAD4" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabClasesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 2: Tareas -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📋" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabTareasLabel"
                           Text="Tareas" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabTareasIndicator"
                             HeightRequest="3" 
                             WidthRequest="24" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTareasTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 3: Calendario -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📅" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabCalendarioLabel"
                           Text="Calendario" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabCalendarioIndicator"
                             HeightRequest="3" 
                             WidthRequest="24" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabCalendarioTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 4: Ajustes -->
                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Label Text="⚙️" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabAjustesLabel"
                           Text="Ajustes" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabAjustesIndicator"
                             HeightRequest="3" 
                             WidthRequest="24" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabAjustesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>