<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.UnitGradesPage"
             Title="Calificaciones por Unidad"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <VerticalStackLayout Spacing="16" Padding="16">

        <!-- Selector de Unidades -->
        <Picker x:Name="PickerUnits"
                Title="Selecciona una Unidad"
                SelectedIndexChanged="OnUnitPickerChanged"
                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" />

        <!-- Resumen del Alumno (Visible solo para alumnos) -->
        <Border x:Name="BorderStudentsSummary"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                StrokeShape="RoundRectangle 12"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                IsVisible="False">
            <VerticalStackLayout Spacing="4">
                <Label Text="Tu Calificación en esta Unidad" FontSize="13" TextColor="#64748B" />
                <Label x:Name="LblStudentFinalGrade" FontSize="24" FontAttributes="Bold" TextColor="#5EEAD4" />
            </VerticalStackLayout>
        </Border>

        <!-- Listado de Calificaciones (Profesor / Alumno) -->
        <CollectionView x:Name="CvGradesSummary" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 10"
                            Padding="14"
                            Margin="0,4"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding StudentName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <Label Text="{Binding StatusText}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding FinalGradeText}" FontSize="16" FontAttributes="Bold" TextColor="#5EEAD4" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>