<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.LoginPage"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalOptions="Center">
        <Grid HorizontalOptions="Center" Margin="0,20">
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2D3748}"
                    StrokeThickness="1"
                    WidthRequest="380"
                    Padding="30">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">
                    <!-- Header logo / título -->
                    <Label Text="WorkFlow"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1A73E8"
                           HorizontalOptions="Center" />

                    <Label Text="Iniciar sesión"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light=#3C4043, Dark=#CBD5E1}"
                           HorizontalOptions="Center" />

                    <!-- Campo Usuario / Correo -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Usuario o Correo" FontSize="12" TextColor="{AppThemeBinding Light=#5F6368, Dark=#94A3B8}" />
                        <Entry x:Name="TxtUsernameOrEmail"
                               Placeholder="ejemplo@cecyt13.ipn.mx"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Contraseña" FontSize="12" TextColor="{AppThemeBinding Light=#5F6368, Dark=#94A3B8}" />
                        <Entry x:Name="TxtPassword"
                               IsPassword="True"
                               Placeholder="••••••••"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </VerticalStackLayout>

                    <!-- Botón de Ingreso -->
                    <Button x:Name="LoginButton"
                            Text="Iniciar Sesión"
                            BackgroundColor="#1A73E8"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="42"
                            Margin="0,10,0,0"
                            Clicked="OnLoginClicked" />

                    <!-- Botón de Registro -->
                    <Button Text="¿No tienes cuenta? Regístrate"
                            BackgroundColor="Transparent"
                            TextColor="#1A73E8"
                            FontSize="13"
                            Clicked="OnRegisterClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>